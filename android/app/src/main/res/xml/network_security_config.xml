<?xml version="1.0" encoding="utf-8"?>
<!--
  The Affluena API is reached over HTTPS (https://affluena.adityabuild.codes/api/v1),
  so production traffic needs NO cleartext exception — Android 9+ (API 28+)
  blocking cleartext by default is exactly the desired behavior. The dev-only
  hosts below (emulator host + loopback) keep plain-HTTP local development
  working; release builds never target them.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
